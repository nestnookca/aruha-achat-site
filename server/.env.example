STRIPE_SECRET_KEY=sk_live_or_sk_test_your_secret_key_here
SITE_URL=https://haimeal.com
PORT=3000

# Supabase (analytics). SUPABASE_SERVICE_KEY bypasses all database security —
# never expose it to the frontend, never commit the real value.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Twilio (used only by send-sms.js, a local CLI tool — not the web server)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+972500000000
